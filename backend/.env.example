DATABASE_URL="mysql://root:root@127.0.0.1:3308/kopi"
JWT_SECRET="ganti-dengan-rahasia-panjang-acak"
NODE_ENV=development
APP_NAME="Kopi App"

# Midtrans (dashboard Midtrans > Settings > Access Keys). Hati-hati huruf besar I vs kecil l.
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_MERCHANT_ID=""
MIDTRANS_IS_PRODUCTION=false

# SMS OTP: console (hanya dev) | twilio | zenziva. Di production wajib twilio/zenziva.
SMS_PROVIDER=console
# twilio
TWILIO_ACCOUNT_SID=""
TWILIO_AUTH_TOKEN=""
TWILIO_FROM=""        # nomor pengirim (+1...) atau Messaging Service SID (MG...)
# zenziva
ZENZIVA_USERKEY=""
ZENZIVA_PASSKEY=""
